/* ---------------------------------------------------------------------------
 * Frontend environment variables (Vite exposes only VITE_* to the client).
 * Anything sensitive (Razorpay key secret, Firebase Admin credentials) must
 * live ONLY in Cloud Functions / backend config — never here.
 * See README "Going live (production architecture)" section.
 * ------------------------------------------------------------------------- */
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Publishable key only (safe for client). Secret key stays server-side.
VITE_RAZORPAY_KEY_ID=

VITE_FUNCTIONS_REGION=asia-south1
